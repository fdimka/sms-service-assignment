# Copy to .env only if you want to override a default.
PORT=3000
DATABASE_PATH=./data/messages.sqlite
WORKER_INTERVAL_MS=250
PROVIDER_TIMEOUT_MS=2000

# Empty means start the bundled local substitute on MOCK_PROVIDER_PORT.
# Set a URL only for a provider implementing docs/PROVIDER_CONTRACT.md.
SMS_PROVIDER_URL=
MOCK_PROVIDER_PORT=4010
